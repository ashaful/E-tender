<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_supplies_bid_decision_wizard_form" model="ir.ui.view">
        <field name="name">supplies.bid.decision.wizard.form</field>
        <field name="model">supplies.bid.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Bid Decision">
                <group>
                    <field name="purchase_order_id" invisible="1"/>
                    <field name="decision"/>
                    <field name="reason" placeholder="Enter the reason for this decision..."/>
                </group>
                <footer>
                    <button name="action_confirm_decision" string="Confirm Decision" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
