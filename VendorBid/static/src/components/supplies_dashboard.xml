<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="supplies.dashboard">
        <Layout display="display" className="'o_dashboard'">
            <div class="container py-2">
                <div class="row align-items-center mt-3">
                    <div class="col-md-7">
                        <div class="d-flex flex-column">
                            <h2 style="font-size: 1.8rem;font-weight: 600;">
                                Vendor Dashboard
                            </h2>
                            <p class="text-muted">
                                Information about the vendors and their statistics.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="d-flex flex-row justify-content-between">
                            <select class="form-select me-1" t-model="state.selectedSupplierId">
                                <i class="fas fa-chevron-down"></i>
                                <option value="0">All Vendors Overview</option>
                                <t t-foreach="state.suppliers" t-as="supplier" t-key="supplier.id">
                                    <option t-att-value="supplier.id" t-out="supplier.name"/>
                                </t>
                            </select>
                            <select class="form-select" t-model="state.selectedPeriod">
                                <option value="0" selected="">All Time</option>
                                <t t-foreach="timeperiods" t-as="period" t-key="period.tag">
                                    <option t-att-value="period.tag" t-out="period.label"/>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <t t-if="state.selectedSupplierId === '0'">
                        <div class="col-12">
                            <div class="procurement-overview">
                                <div class="overview-heading">
                                    <div>
                                        <h3>Approver Control Center</h3>
                                        <p>RFP progress, vendor quotations, document readiness, and decisions across the organization.</p>
                                    </div>
                                    <span class="overview-period"><i class="fa fa-calendar me-2"/><t t-out="selectedPeriodLabel"/></span>
                                </div>

                                <div class="overview-stats">
                                    <div class="overview-stat overview-stat-blue">
                                        <div class="overview-stat-icon"><i class="fa fa-file-text-o"/></div>
                                        <div><span>Total RFPs</span><strong t-out="state.overview.stats.totalRfps"/></div>
                                    </div>
                                    <div class="overview-stat overview-stat-teal">
                                        <div class="overview-stat-icon"><i class="fa fa-bullhorn"/></div>
                                        <div><span>Published RFPs</span><strong t-out="state.overview.stats.publishedRfps"/></div>
                                    </div>
                                    <div class="overview-stat overview-stat-amber">
                                        <div class="overview-stat-icon"><i class="fa fa-clock-o"/></div>
                                        <div><span>Awaiting Decision</span><strong t-out="state.overview.stats.awaitingDecision"/></div>
                                    </div>
                                    <div class="overview-stat overview-stat-indigo">
                                        <div class="overview-stat-icon"><i class="fa fa-tasks"/></div>
                                        <div><span>RFPs in Review</span><strong t-out="state.overview.stats.rfpReviewQueue"/></div>
                                    </div>
                                    <div class="overview-stat overview-stat-green">
                                        <div class="overview-stat-icon"><i class="fa fa-line-chart"/></div>
                                        <div><span>Awarded Value</span><strong t-out="state.overview.stats.awardedValue"/></div>
                                    </div>
                                    <div class="overview-stat overview-stat-slate">
                                        <div class="overview-stat-icon"><i class="fa fa-building-o"/></div>
                                        <div><span>Active Vendors</span><strong t-out="state.overview.stats.activeVendors"/></div>
                                    </div>
                                    <div class="overview-stat overview-stat-teal">
                                        <div class="overview-stat-icon"><i class="fa fa-check-circle-o"/></div>
                                        <div><span>Document-Ready Vendors</span><strong><t t-out="state.overview.stats.documentReadyVendors"/> / <t t-out="state.overview.stats.activeVendors"/></strong></div>
                                    </div>
                                    <div class="overview-stat overview-stat-blue">
                                        <div class="overview-stat-icon"><i class="fa fa-pie-chart"/></div>
                                        <div><span>Decision Coverage</span><strong t-out="state.overview.stats.decisionCoverage"/></div>
                                    </div>
                                    <div class="overview-stat overview-stat-indigo">
                                        <div class="overview-stat-icon"><i class="fa fa-gavel"/></div>
                                        <div><span>Awarded RFPs</span><strong t-out="state.overview.stats.awardedRfps"/></div>
                                    </div>
                                    <div class="overview-stat overview-stat-slate">
                                        <div class="overview-stat-icon"><i class="fa fa-exchange"/></div>
                                        <div><span>Average Quotes / RFP</span><strong t-out="state.overview.stats.averageQuotes"/></div>
                                    </div>
                                </div>

                                <div class="row g-3 mt-1">
                                    <div class="col-lg-7">
                                        <section class="overview-panel h-100">
                                            <div class="overview-panel-heading">
                                                <div><h4>Vendor Quotations Awaiting Decision</h4><p>Most recent submitted quotations requiring procurement action.</p></div>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table overview-table mb-0">
                                                    <thead><tr><th>Quotation</th><th>Vendor</th><th>RFP</th><th>Submitted</th><th class="text-end">Amount</th><th/></tr></thead>
                                                    <tbody>
                                                        <t t-if="state.overview.pendingQuotes.length">
                                                            <tr t-foreach="state.overview.pendingQuotes" t-as="quote" t-key="quote.id">
                                                                <td t-out="quote.name"/>
                                                                <td t-out="quote.vendor_name"/>
                                                                <td t-out="quote.rfp_number"/>
                                                                <td t-out="quote.submitted_display"/>
                                                                <td class="text-end" t-out="quote.amount_display"/>
                                                                <td><button type="button" class="btn btn-link overview-open" t-att-data-quotation-id="quote.id" t-on-click="openQuotation" title="Open quotation"><i class="fa fa-arrow-right"/></button></td>
                                                            </tr>
                                                        </t>
                                                        <tr t-else=""><td colspan="6" class="overview-empty">No quotations currently require a decision.</td></tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="col-lg-5">
                                        <section class="overview-panel h-100">
                                            <div class="overview-panel-heading"><div><h4>Upcoming Submission Deadlines</h4><p>Published RFPs ordered by their closing date.</p></div></div>
                                            <div class="deadline-list">
                                                <t t-if="state.overview.upcomingDeadlines.length">
                                                    <button type="button" class="deadline-item" t-foreach="state.overview.upcomingDeadlines" t-as="rfp" t-key="rfp.id" t-att-data-rfp-id="rfp.id" t-on-click="openRfp">
                                                        <span class="deadline-date"><i class="fa fa-calendar-o"/><t t-out="rfp.submission_deadline"/></span>
                                                        <span><strong t-out="rfp.rfp_number"/><small t-out="rfp.rfp_title || 'Untitled RFP'"/></span>
                                                        <i class="fa fa-chevron-right"/>
                                                    </button>
                                                </t>
                                                <p t-else="" class="overview-empty mb-0">No published RFP deadlines in this period.</p>
                                            </div>
                                        </section>
                                    </div>
                                </div>

                                <div class="row g-3 mt-1">
                                    <div class="col-lg-5">
                                        <section class="overview-panel h-100">
                                            <div class="overview-panel-heading"><div><h4>RFP Pipeline</h4><p>Current workload by procurement stage.</p></div></div>
                                            <div class="pipeline-list">
                                                <div t-foreach="state.overview.rfpPipeline" t-as="stage" t-key="stage.label" class="pipeline-item">
                                                    <span t-att-class="'pipeline-dot ' + stage.style"/><span t-out="stage.label"/><strong t-out="stage.count"/>
                                                </div>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="col-lg-7">
                                        <section class="overview-panel h-100">
                                            <div class="overview-panel-heading"><div><h4>Highest-Value Vendor Quotations</h4><p>Active quotations ranked by submitted total.</p></div></div>
                                            <div class="table-responsive">
                                                <table class="table overview-table mb-0">
                                                    <thead><tr><th>Vendor</th><th>RFP</th><th>Decision</th><th class="text-end">Amount</th><th/></tr></thead>
                                                    <tbody>
                                                        <t t-if="state.overview.highValueQuotes.length">
                                                            <tr t-foreach="state.overview.highValueQuotes" t-as="quote" t-key="quote.id">
                                                                <td t-out="quote.vendor_name"/><td t-out="quote.rfp_number"/>
                                                                <td><span t-att-class="'decision-badge decision-' + quote.bid_decision" t-out="quote.decision_label"/></td>
                                                                <td class="text-end" t-out="quote.amount_display"/>
                                                                <td><button type="button" class="btn btn-link overview-open" t-att-data-quotation-id="quote.id" t-on-click="openQuotation" title="Open quotation"><i class="fa fa-arrow-right"/></button></td>
                                                            </tr>
                                                        </t>
                                                        <tr t-else=""><td colspan="5" class="overview-empty">No active quotations are available.</td></tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </section>
                                    </div>
                                </div>

                                <div class="row g-3 mt-1">
                                    <div class="col-lg-6"><section class="overview-panel chart-panel"><Graph title="'RFP Lifecycle'" type="'bar'" data="state.overview.rfpStatusChartData"/></section></div>
                                    <div class="col-lg-6"><section class="overview-panel chart-panel"><Graph title="'Quotation Decisions'" type="'doughnut'" data="state.overview.bidDecisionChartData"/></section></div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <div class="col-md-8">
                        <t t-if="state.selectedSupplierId !== '0'">
                            <StatBar rfp_stats="state.rfp"/>
                            <t t-if="state.productLines.length > 0">
                                <div class="my-3 p-4 bg-white products-container shadow-1 border-1">
                                    <h2 class="text-muted" style="font-weight: 600">Product Breakdown</h2>
                                    <div class="table-responsive border-1" style="max-height: calc(100vh - 300px); overflow-y: auto;">
                                        <table class="table table-hover border-1 mb-0">
                                            <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                                                <tr>
                                                    <th>Product</th>
                                                    <th>Quantity</th>
                                                    <th>Avg. Unit Price</th>
                                                    <th>Total (<t t-out="state.currency"/>)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="state.productLines" t-as="line" t-key="line.id">
                                                    <tr>
                                                        <td>
                                                            <img t-att-src="'data:image/png;base64,' + line.product_image" alt="product"
                                                                 class="img-fluid rounded me-2 border" width="80"/>
                                                            <h4 class="d-inline" t-out="line.product_name"/>
                                                        </td>
                                                        <td t-out="line.total_qty"/>
                                                        <td t-out="line.avg_qty_price"/>
                                                        <td t-out="line.subtotal_purchase"/>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </t>
                            <t t-else="">
                                <div class="bg-white border-1 d-flex flex-column justify-content-center align-items-center mt-3"
                                     style="padding: 7rem 0;">
                                    <p class="text-muted text-center">
                                        No purchase data available for the selection.
                                    </p>
                                </div>
                            </t>
                            
                        </t>
                    </div>
                    <div class="col-md-4">
                        <CompanyCard
                                t-if="state.selectedSupplierId !== '0'"
                                supplierId="state.selectedSupplierId"
                                all_suppliers="state.suppliers"
                        />
                        <t t-if="state.selectedSupplierId !== '0'">
                            <div t-if="state.rfqStatusChartData" class="bg-white p-4 shadow-1 border-1 mt-3">
                                <Graph title="'RFQ Status'" type="'doughnut'" data="state.rfqStatusChartData"/>
                            </div>
                            <div t-if="state.rfpPurchaseChartData" class="bg-white p-4 shadow-1 border-1 mt-3">
                                <Graph title="'Purchase Breakdown'" type="'line'" data="state.rfpPurchaseChartData"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </Layout>
    </t>
</templates>
