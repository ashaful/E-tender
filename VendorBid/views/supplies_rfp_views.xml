<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_supplies_rfp_tree" model="ir.ui.view">
        <field name="name">supplies.rfp.tree</field>
        <field name="model">supplies.rfp</field>
        <field name="arch" type="xml">
            <list string="Request for Purchases">
                <field name="rfp_number" string="Reference"/>
                <field name="create_uid" string="Requested By"/>
                <field name="required_date"/>
                <field
                        name="state"
                        widget="badge"
                        decoration-warning="state in ('draft',)"
                        decoration-danger="state in ('rejected',)"
                        decoration-info="state in ('approved',)"
                        decoration-primary="state in ('recommendation',)"
                        decoration-success="state in ('accepted',)"
                />
            </list>
        </field>
    </record>

    <record id="view_supplies_rfp_form" model="ir.ui.view">
        <field name="name">supplies.rfp.form</field>
        <field name="model">supplies.rfp</field>
        <field name="arch" type="xml">
            <form string="Request for Purchase">
                <header>
                    <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="draft,submitted,approved,published,closed,recommendation,awarded"
                            invisible="state == 'rejected'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted"
                           invisible="state != 'rejected'"/>
                    <button
                            name="action_submit"
                            string="Submit"
                            class="oe_highlight"
                            type="object"
                            icon="fa-paper-plane"
                            groups="VendorBid.group_supplies_reviewer"
                            invisible="state != 'draft'"
                    />
                    <!-- Button for reviewers in submitted and rejected state -->
                    <button
                            name="action_return_to_draft"
                            string="Return to Draft"
                            type="object"
                            icon="fa-undo"
                            groups="VendorBid.group_supplies_reviewer"
                            invisible="state not in ('submitted','rejected')"
                    />

                    <button
                            name="action_recommendation"
                            string="Recommend"
                            type="object"
                            class="btn-primary"
                            icon="fa-paper-plane-o"
                            groups="VendorBid.group_supplies_reviewer"
                            invisible="state != 'closed'"
                    />
                    <button
                            name="action_approve"
                            string="Approve"
                            class="oe_highlight"
                            type="object"
                            icon="fa-check"
                            groups="VendorBid.group_supplies_approver"
                            invisible="state != 'submitted'"
                    />
                    <button
                            name="action_reject"
                            string="Reject"
                            class="btn-warning"
                            type="object"
                            icon="fa-close"
                            groups="VendorBid.group_supplies_approver"
                            invisible="state != 'submitted'"
                    />
                    <button
                            name="action_close"
                            string="Close This RFP"
                            type="object"
                            class="btn-primary"
                            groups="VendorBid.group_supplies_approver"
                            invisible="state not in ('approved', 'published')"
                    />
                    <button
                            name="action_publish"
                            string="Publish"
                            type="object"
                            class="oe_highlight"
                            groups="VendorBid.group_supplies_reviewer"
                            invisible="state != 'approved'"
                    />
                    <button
                            name="action_extend_deadline"
                            string="Record Extension"
                            type="object"
                            groups="VendorBid.group_supplies_reviewer"
                            invisible="state != 'published'"
                    />
                    <button
                            name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-warning"
                            groups="VendorBid.group_supplies_reviewer"
                            invisible="state in ('closed','awarded','accepted','cancelled')"
                    />

                </header>
                <sheet>
                    <field name="state" invisible="1"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Awarded" bg_color="text-bg-success"
                            invisible="state not in ('accepted', 'awarded')"/>
                    <div class="oe_button_box" name="button_box">

                        <button type="object" name="action_view_all_rfq" class="oe_stat_button" icon="fa-cube"
                                invisible="state in ['draft','submitted']">
                            <field widget="statinfo" name="total_rfq" string="Quotations"> </field>
                        </button>

                        <button type="object" name="action_view_all_rfq" class="oe_stat_button" icon="fa-cube" invisible="state in ['draft','submitted','approved']">
                        <field name="total_rfq"> </field>
                        <span>RFQs</span>

                        </button>
                        <button type="object" name="action_view_purchase_order" class="oe_stat_button" icon="fa-cube"
                                invisible="state not in ('accepted', 'awarded')">View Purchase Order </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="rfp_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_id" readonly="state != 'draft'"/>
                            <field name="rfp_title" required="1" readonly="state not in ('draft','submitted','approved')"/>
                            <field name="visibility" readonly="state not in ('draft','submitted','approved')"/>
                            <field name="product_category_id" required="1" readonly="product_line_ids" force_save="1"/>
                            <field name="create_uid" string="Requested By"/>
                            <field name="review_by" string="Approved By"
                                   invisible="not id or state in ['draft', 'submitted', 'rejected']"/>
                            <field name="review_by" string="Rejected By" invisible="state not in ['rejected']"/>
                            <field name="date_approve" string="Rejected On" invisible="state not in ['rejected']"/>
                        </group>
                        <group>

                            <field name="required_date" readonly="state != 'draft'"/>
                            <field name="submission_deadline" required="1" readonly="state in ('closed','awarded','accepted','cancelled')"/>
                            <field name="old_submission_deadline" readonly="1"/>
                            <field name="publish_date" readonly="1"/>
                            <field
                                    name="approved_supplier_id"
                                    context="{'search_default_supplier': 1}"
                                    options="{'no_open': True}"
                                    invisible="not id or state != 'accepted'"
                                    readonly="1"
                            />
                            <field name="date_approve" string="Approved On"
                                   invisible="not id or state in ['draft', 'submitted', 'rejected']"/>
                            <field name="total_amount" invisible="not id or state != 'accepted'" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="scope" required="1" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="business_justification" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="delivery_location" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="buyer_contact" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="eligibility_requirements" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="payment_terms" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="bid_validity" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="pricing_instruction" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="mandatory_bid_documents" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="terms_conditions" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="attachment" filename="attachment_filename" readonly="state not in ('draft','submitted','approved')"/>
                        <field name="attachment_filename" invisible="1"/>
                        <field name="deadline_extension_reason" invisible="state != 'published'"/>
                        <field name="cancellation_reason" invisible="state in ('closed','awarded','accepted','cancelled')"/>
                    </group>

                    <notebook>
                        <page string="Private Vendors" invisible="visibility != 'private'">
                            <field name="selected_vendor_ids" readonly="state not in ('draft','submitted','approved')" context="{'search_default_supplier': 1}">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="product_category_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Product Lines">
                            <field
                                    name="product_line_ids"
                                    context="{'default_rfp_id': id}"
                                    readonly="state != 'draft'"
                            >
                                <list editable="bottom">
                                    <field name="product_id" string="Product"/>
                                    <field name="product_image" widget="image" options='{"size": [120, 120]}'/>
                                    <field name="description" string="Description"/>
                                    <field name="product_qty" string="Quantity"/>
                                    <field name="product_uom" string="UoM"/>
                                </list>
                            </field>
                        </page>

                        <page string="RFQs">
                            <field
                                    name="rfq_ids"
                                    options="{'create': 0, 'delete': 0}"
                                    readonly="state in ('recommendation', 'accepted')"
                            >
                                <list default_order="score desc">
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name" string="Reference"/>
                                    <field name="partner_id" string="Supplier"/>
                                    <field name="create_date" string="Posted On"/>
                                    <field name="date_planned" string="Delivery Date"/>
                                    <field name="warrenty_period" string="Warrenty Period (Month)"/>
                                    <field name="amount_total" string="Total"/>
                                    <field name="score"/>
                                    <field name="recommended"/>
                                    <field name="bid_decision"/>
                                    <field name="bid_submitted_at"/>
                                </list>
                                <form string="RFQ">
                                    <header>
                                        <button
                                                name="action_open_accept_wizard"
                                                string="Accept"
                                                type="object"
                                                class="btn-primary"
                                                groups="VendorBid.group_supplies_approver"
                                                invisible="parent.state != 'recommendation'"
                                        />
                                        <button name="action_open_reject_wizard" string="Reject Bid" type="object" class="btn-warning" groups="VendorBid.group_supplies_reviewer" invisible="parent.state not in ('closed','recommendation')"/>
                                        <button name="action_open_clarification_wizard" string="Clarification Required" type="object" groups="VendorBid.group_supplies_reviewer" invisible="parent.state not in ('closed','recommendation')"/>
                                    </header>
                                    <group>
                                        <group>
                                            <field name="partner_id" options="{'no_open': True}" readonly="1"/>
                                            <field name="date_planned" readonly="1"/>
                                            <field name="warrenty_period" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="score"/>
                                            <field name="recommended"/>
                                            <field name="bid_decision" readonly="1"/>
                                            <field name="bid_submitted_at" readonly="1"/>
                                            <field name="decision_reason" readonly="1"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page string="RFQ Lines">
                                            <field name="order_line" readonly="1">
                                                <list>
                                                    <field name="currency_id" column_invisible="1"/>
                                                    <field name="product_id"/>
                                                    <field name="product_qty"/>
                                                    <field name="product_uom"/>
                                                    <field name="price_unit"/>
                                                    <field name="delivery_charge"/>
                                                    <field name="price_subtotal"/>
                                                </list>
                                            </field>
                                            <group>
                                                <group>
                                                    <field colspan="2" name="notes" nolabel="1" readonly="1"/>
                                                </group>
                                                <group class="oe_subtotal_footer">
                                                    <field name="tax_totals" widget="account-tax-totals-field"
                                                           nolabel="1" colspan="2" readonly="1"/>
                                                </group>
                                            </group>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_supplies_rfp_search" model="ir.ui.view">
        <field name="name">supplies.rfp.search</field>
        <field name="model">supplies.rfp</field>
        <field name="arch" type="xml">
            <search string="Search Request for Purchases">
                <field name="rfp_number" string="Reference"/>
                <field name="create_uid" string="Requested By"/>
                <field name="required_date"/>
                <filter name="running" string="Running"
                        domain="[('state', 'not in', ('closed', 'rejected', 'accepted', 'awarded', 'cancelled'))]"/>
                <searchpanel>
                    <field name="state"/>
                    <field name="approved_supplier_id" string="Supplier"/>
                </searchpanel>
            </search>
        </field>
    </record>


    <record id="supplies_rfp_graph_view" model="ir.ui.view">
        <field name="name">supplies.rfp.graph.view</field>
        <field name="model">supplies.rfp</field>
        <field name="arch" type="xml">
            <graph string="Request for Purchases" type="line" disable_linking="1" stacked="0">
                <field name="required_date" type="row" interval="month"/>
                <field name="total_amount" type="measure"/>
                <field name="rfp_number" type="group"/>
                <field name="approved_supplier_id" type="group"/>
                <field name="state" type="group"/>
            </graph>
        </field>
    </record>

    <record id="view_supplies_rfp_pivot" model="ir.ui.view">
        <field name="name">supplies.rfp.pivot</field>
        <field name="model">supplies.rfp</field>
        <field name="arch" type="xml">
            <pivot string="RFP Pivot" display_quantity="1" disable_linking="1" default_order="total_amount desc">
                <field name="approved_supplier_id" type="row"/>
                <field name="state" type="row"/>
                <field name="required_date" type="col" interval="month"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>


    <record id="supplies_rfp_action" model="ir.actions.act_window">
        <field name="name">Request For Purchases</field>
        <field name="res_model">supplies.rfp</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Request for Purchases
            </p>
        </field>
        <field name="context">{'search_default_running': 1}</field>
    </record>
</odoo>
