<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_supplies_request_tree" model="ir.ui.view">
        <field name="name">supplies.request.list</field>
        <field name="model">supplies.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_number"/>
                <field name="request_date"/>
                <field name="requester_id"/>
                <field name="request_category"/>
                <field name="title"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_supplies_request_form" model="ir.ui.view">
        <field name="name">supplies.request.form</field>
        <field name="model">supplies.request</field>
        <field name="arch" type="xml">
            <form string="Procurement Request">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" groups="VendorBid.group_supplies_approver" invisible="state != 'submitted'"/>
                    <button name="action_return_for_correction" type="object" string="Return for Correction" groups="VendorBid.group_supplies_approver" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject" groups="VendorBid.group_supplies_approver" invisible="state != 'submitted'"/>
                    <button name="action_create_rfp" type="object" string="Create RFP" class="oe_highlight" groups="VendorBid.group_supplies_reviewer" invisible="state != 'approved'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="request_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_date"/>
                            <field name="requester_id"/>
                            <field name="department"/>
                            <field name="request_category"/>
                            <field name="title"/>
                            <field name="vendor_category_id"/>
                        </group>
                        <group>
                            <field name="estimated_budget"/>
                            <field name="currency_id"/>
                            <field name="delivery_location"/>
                            <field name="approver_id" readonly="1"/>
                            <field name="rfp_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="business_justification"/>
                        <field name="description"/>
                        <field name="decision_reason" placeholder="Required before reject or return for correction"/>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="state not in ('draft', 'correction')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="required_date"/>
                                    <field name="expected_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="supplies_request_action" model="ir.actions.act_window">
        <field name="name">Procurement Requests</field>
        <field name="res_model">supplies.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
