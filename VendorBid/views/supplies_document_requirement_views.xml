<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_supplies_document_requirement_list" model="ir.ui.view">
        <field name="name">supplies.document.requirement.list</field>
        <field name="model">supplies.document.requirement</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="vendor_category_id"/>
                <field name="document_field"/>
                <field name="required"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_supplies_document_requirement_form" model="ir.ui.view">
        <field name="name">supplies.document.requirement.form</field>
        <field name="model">supplies.document.requirement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate_category_vendors" type="object" string="Validate Vendors" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="vendor_category_id"/>
                        <field name="document_field"/>
                        <field name="required"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="supplies_document_requirement_action" model="ir.actions.act_window">
        <field name="name">Vendor Document Matrix</field>
        <field name="res_model">supplies.document.requirement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
