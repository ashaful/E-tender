<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="rfp_id" invisible="not rfp_id" readonly="1"/>
                    <field name="bid_submitted_at" invisible="not rfp_id" readonly="1"/>
                    <field name="bid_decision" invisible="not rfp_id"/>
                    <field name="decision_reason" invisible="not rfp_id"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Bid Documents" invisible="not rfp_id">
                        <group>
                            <field name="signed_quotation_doc" filename="signed_quotation_filename"/>
                            <field name="signed_quotation_filename" invisible="1"/>
                            <field name="technical_proposal_doc" filename="technical_proposal_filename"/>
                            <field name="technical_proposal_filename" invisible="1"/>
                            <field name="experience_evidence_doc" filename="experience_evidence_filename"/>
                            <field name="experience_evidence_filename" invisible="1"/>
                            <field name="rfp_specific_doc" filename="rfp_specific_filename"/>
                            <field name="rfp_specific_filename" invisible="1"/>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                    <field name="delivery_charge" column_invisible="not parent.rfp_id"/>
                </xpath>

                <!-- Modify 'bid_confirm' button: visible when user is not reviewer -->
                <xpath expr="//button[@id='bid_confirm']" position="attributes">
                    <attribute name="groups">VendorBid.group_supplies_approver</attribute>
                </xpath>

                <!-- Modify 'draft_confirm' button: visible when user is not reviewer -->
                <xpath expr="//button[@id='draft_confirm']" position="attributes">
                    <attribute name="groups">VendorBid.group_supplies_approver</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
